# Copy these into Railway (Variables) or your host's environment settings.

# REQUIRED — Postgres connection string (the app will not start without it).
# Railway Postgres: use the "DATABASE_URL" it provides for the Postgres service.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Role passwords (recommended in production; otherwise dev fallbacks are used).
ECOMAJES_ADMIN_PASSWORD=change-me
ECOMAJES_GERENCIA_PASSWORD=change-me
